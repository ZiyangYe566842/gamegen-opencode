# Authenticate coding providers with `opencode auth login`.
# The OpenAI image asset pipeline reads OPENAI_API_KEY here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Presets are examples; verify model IDs with `opencode models --refresh`.
# Options: free | cheap | balanced | deep | experimental
GAMEGEN_MODEL_PROFILE=balanced
GAMEGEN_MODEL_OVERRIDE=
